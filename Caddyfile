# Caddy is the only HTTP/HTTPS ingress for the stack.
#
# Port 80 intentionally serves the app for any hostname. This makes the default
# Docker start reachable as http://<host>/ without requiring SC_PUBLIC_HOSTNAME
# to match first.

{
	auto_https disable_redirects
	servers {
		# Long-running streaming responses must not be proxy-buffered.
		timeouts {
			read_body 30s
			read_header 10s
			idle 5m
		}
	}
}

:80 {
	encode zstd gzip

	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		flush_interval -1
	}
}

{$SC_PUBLIC_HOSTNAME:sentinelcam.local} {
	tls {$SC_TLS_EMAIL:internal}
	encode zstd gzip

	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		flush_interval -1
	}
}
