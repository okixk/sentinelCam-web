# Caddy is the only HTTP/HTTPS ingress for the stack.
#
# Without SC_PUBLIC_HOSTNAME set, the default hostname is `sentinelcam.local`
# and Caddy uses its built-in local CA ("tls internal"). Set SC_PUBLIC_HOSTNAME
# (real DNS name) + SC_TLS_EMAIL (your email) in .env to switch to Let's
# Encrypt.

{
	auto_https disable_redirects
	servers {
		# Long-running streaming responses must not be proxy-buffered.
		timeouts {
			read_body 30s
			read_header 10s
			idle 5m
		}
	}
}

{$SC_PUBLIC_HOSTNAME:sentinelcam.local} {
	tls {$SC_TLS_EMAIL:internal}
	encode zstd gzip

	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		flush_interval -1
	}
}

# Plain-HTTP -> HTTPS redirect for the same hostname.
http://{$SC_PUBLIC_HOSTNAME:sentinelcam.local} {
	redir https://{host}{uri} permanent
}
