# Shared secret between web proxy and worker
WORKER_TOKEN=change-me-to-a-strong-random-token-min-32-chars

# Worker URL for the web container.
# Default for the base compose file: http://host.docker.internal:8080
# Linux stack override:               http://worker:8080
#WORKER_BASE_URL=http://host.docker.internal:8080

# Initial admin credentials (only used on first startup when DB is empty)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-min-12-chars

# WebAuthn RP ID (set to your domain in production, localhost for dev)
WEBAUTHN_RP_ID=localhost

# Worker video source (Linux Docker only).
# Camera index (e.g. 0) requires webcam passthrough (docker-compose.linux-cam.yml).
# Remote streams work without device passthrough.
#WORKER_SOURCE=0
#WORKER_SOURCE=rtsp://192.168.1.100:8554/stream

# Webcam device path for Linux Docker passthrough (default: /dev/video0)
#WORKER_VIDEO_DEVICE=/dev/video0
