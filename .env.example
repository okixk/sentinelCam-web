# sentinelCam-web stack: required and optional environment variables.
# Copy this file to .env and fill in the secrets before `docker compose up`.

# -- Web app -----------------------------------------------------------------
# Initial admin credentials are used only when the users table is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-min-12-chars

# WebAuthn relying-party ID. Use the DNS name the browser sees (no scheme,
# no port). Use "localhost" for local development.
WEBAUTHN_RP_ID=localhost

# Optional: alter the web port inside the container.
#WEB_PORT=3000

# Optional first-start login security defaults. Admin dashboard changes are
# stored in PostgreSQL and override these values after startup.
#LOGIN_RATE_LIMIT=5
#LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
#LOCKOUT_THRESHOLD=10
#LOCKOUT_DURATION_MINUTES=30

# -- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=sentinelcam
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=sentinelcam

# -- Local recording storage ------------------------------------------------
# In Docker this path is backed by the `recordings-data` named volume.
LOCAL_STORAGE_PATH=/data/recordings

# -- Reverse proxy / TLS -----------------------------------------------------
# Default hostname uses Caddy's built-in local CA. Set a real DNS name and
# email to switch to Let's Encrypt automatically.
#SC_PUBLIC_HOSTNAME=sentinelcam.local
#SC_TLS_EMAIL=internal

# -- WireGuard VPN (wg-easy) -------------------------------------------------
# WG_HOST is the hostname/IP that VPN clients dial. For LAN-only access this
# is your server's LAN IP. For a public endpoint, set the public IP/DNS name.
WG_HOST=localhost
WG_PORT=51820
WG_DEFAULT_DNS=1.1.1.1
WG_ALLOWED_IPS=0.0.0.0/0, ::/0
WG_PERSISTENT_KEEPALIVE=25
# Bcrypt hash for the wg-easy admin UI password. Generate one with:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'your-vpn-admin-password'
# The output starts with `$2a$...`. Keep the single quotes when pasting here
# so docker compose does not interpret the $ signs.
WG_PASSWORD_HASH='$2a$REPLACE_WITH_BCRYPT_HASH'
