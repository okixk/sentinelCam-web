# Shared secret between web proxy and worker
WORKER_TOKEN=change-me-to-a-strong-random-token-min-32-chars

# Web app port
#WEB_PORT=3000

# Bind the web app publicly when running it directly outside Docker.
# Use SC_PUBLIC instead of PUBLIC to avoid collisions with the Windows %PUBLIC% env var.
#SC_PUBLIC=0

# Worker URL for the web container.
# The single docker-compose.yml points the web app at the worker on the host network.
# You normally do not need to change this.
#WORKER_BASE_URL=http://host.docker.internal:8080

# Initial admin credentials (only used on first startup when DB is empty)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-min-12-chars

# WebAuthn RP ID (set to your domain in production, localhost for dev)
WEBAUTHN_RP_ID=localhost

# Worker video source for the Docker worker.
# Helper scripts also read this value for local Linux worker startup.
# Camera index (e.g. 0) uses the device path below.
# You can also use a URL/file source such as RTSP.
# If you use a remote stream on a host without a webcam, set
# WORKER_VIDEO_DEVICE=/dev/null so Docker does not look for /dev/video0.
#WORKER_SOURCE=0
#WORKER_SOURCE=rtsp://192.168.1.100:8554/stream

# Bind host for local Linux helper startup and the Linux Docker worker.
# Keep 0.0.0.0 unless you know you need a different non-loopback address.
#WORKER_BIND_HOST=0.0.0.0

# Docker worker stream tuning.
# These map to the worker CLI flags in webcam.py.
# auto values keep the worker's hardware-aware defaults.
#WORKER_STREAM_MODE=auto
#WORKER_PERFORMANCE_PROFILE=auto
#WORKER_STREAM_QUALITY=auto
#WORKER_JPEG_QUALITY=88
#WORKER_WEBRTC_CODEC=auto
#WORKER_WEBRTC_BITRATE=-1
#WORKER_WEBRTC_FPS=0
#WORKER_CAMERA_FPS=0

# Useful Linux quality examples:
#WORKER_STREAM_QUALITY=high
#WORKER_WEBRTC_BITRATE=8000
#WORKER_WEBRTC_FPS=30
#WORKER_CAMERA_FPS=30

# Webcam device path for the Docker worker on Linux (default: /dev/video0)
# Use /dev/video2 for another camera, or /dev/null for remote-stream-only hosts.
#WORKER_VIDEO_DEVICE=/dev/video0
#WORKER_VIDEO_DEVICE=/dev/null
